# Configuração do Ambiente — API NF Inteligente
# Copie para .env e preencha os valores reais

# ─── Banco de Dados ────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/nf_inteligente?schema=public"

# ─── JWT ───────────────────────────────────────────────────────
JWT_SECRET="TROQUE_POR_UMA_STRING_LONGA_E_ALEATORIA_AQUI"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="TROQUE_POR_OUTRA_STRING_LONGA_AQUI"
JWT_REFRESH_EXPIRES_IN="30d"

# ─── Servidor ──────────────────────────────────────────────────
PORT=3001
NODE_ENV="development"

# ─── CORS ──────────────────────────────────────────────────────
# Origens permitidas (frontend)
CORS_ORIGIN="http://localhost:3000"

# ─── IA Fiscal (Claude) — Fase 4 ──────────────────────────────
ANTHROPIC_API_KEY=""

# ─── NFS-e Agregador (Plugnotas) — Fase 3 ─────────────────────
PLUGNOTAS_API_KEY=""
PLUGNOTAS_ENV="sandbox"

# ─── Criptografia de Certificados A1 ──────────────────────────
CERT_ENCRYPTION_KEY="TROQUE_POR_32_BYTES_HEX"
